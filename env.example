# Copia este archivo como .env y completa los datos de un proveedor de correo SMTP.
# No compartas ni subas .env a repositorios públicos.
REPORT_EMAIL=tu-correo@ejemplo.com
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=contrasena-o-clave-de-aplicacion
# Opcional; si queda vacío se utiliza SMTP_USER
REPORT_FROM=
